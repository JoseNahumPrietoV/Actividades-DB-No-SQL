# ==============================================================
# SNACKVER - VARIABLES DE ENTORNO Y CONFIGURACIÓN (UNIDAD 2)
# ==============================================================

# Entorno: development | production
APP_ENV=development
APP_URL=http://localhost/Proyecto-Sistema-de-entrega-de-comida

# --------------------------------------------------------------
# 1. BASE DE DATOS NOSQL: MONGODB ATLAS (GitHub Student Pack)
# --------------------------------------------------------------
# Pega aquí tu URI de conexión que te da MongoDB Atlas:
# Ejemplo: mongodb+srv://admin_snackver:tu_password@snackver-cluster.xxxx.mongodb.net/sistemawebsnackver?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/sistemawebsnackver?retryWrites=true&w=majority
MONGO_DB_NAME=sistemawebsnackver

# --------------------------------------------------------------
# 2. SERVICIO DE CORREO: GMAIL SMTP / PHPMailer (Verificación OTP 2FA)
# --------------------------------------------------------------
# Instrucciones para generar la contraseña de aplicación de Google:
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en 2 pasos (activarla si no está activa).
# 2. Busca "Contraseñas de aplicaciones" (App Passwords).
# 3. Genera una contraseña para "Snackver" y pégala aquí abajo (son 16 caracteres sin espacios):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=tu_correo@gmail.com
SMTP_PASS="tu_contraseña_de_aplicacion_16_caracteres"
SMTP_FROM_NAME="Snackver Campus"

# --------------------------------------------------------------
# 3. ALMACENAMIENTO DE IMÁGENES EN LA NUBE: CLOUDINARY
# --------------------------------------------------------------
# Regístrate gratis en https://cloudinary.com (Dashboard principal):
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_UPLOAD_FOLDER=snackver_platillos

# --------------------------------------------------------------
# 4. DOMINIO Y SSL: NAMECHEAP (GitHub Student Pack)
# --------------------------------------------------------------
APP_DOMAIN=snackver.me
