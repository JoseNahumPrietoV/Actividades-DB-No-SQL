<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Administración - NextStop</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen font-sans">
    <!-- Navbar -->
    <nav class="bg-slate-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <span class="text-2xl font-bold text-orange-500">NextStop</span>
                    <span class="px-2 py-1 bg-red-600 text-xs font-semibold rounded uppercase tracking-wider">Admin</span>
                </div>
                <div class="flex items-center space-x-6">
                    <span class="text-sm">Hola, <b>{{ nombre }}</b></span>
                    <a href="{{ url_for('logout') }}" class="text-sm text-slate-300 hover:text-white transition">Cerrar Sesión</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Alertas Flash -->
        {% with messages = get_flashed_messages(with_categories=true) %}
          {% if messages %}
            {% for category, message in messages %}
              <div class="mb-6 p-4 rounded-lg text-sm font-medium {% if category == 'success' %}bg-green-100 text-green-800 border border-green-200{% else %}bg-red-100 text-red-800 border border-red-200{% endif %}">
                  {{ message }}
              </div>
            {% endfor %}
          {% endif %}
        {% endwith %}

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-800">Control de Usuarios</h1>
            <p class="text-slate-500 mt-2">Gestiona los clientes y proveedores registrados en la plataforma.</p>
        </div>

        <div class="bg-white rounded-xl shadow border border-slate-200 overflow-hidden">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-100">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Nombre</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Correo</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Teléfono</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Tipo de Perfil</th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    {% for u in usuarios %}
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">{{ u.nombre }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">{{ u.correo }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">{{ u.telefono or 'N/A' }}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if u.rol == 'proveedor' %}
                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Agencia</span>
                            {% else %}
                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-emerald-100 text-emerald-800">Cliente</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                            <form action="{{ url_for('admin_eliminar_usuario', usuario_id=u._id) }}" method="POST" onsubmit="return confirm('¿Estás seguro de eliminar permanentemente a este usuario del sistema?');">
                                <button type="submit" class="text-red-600 hover:text-red-900 font-semibold bg-red-50 px-3 py-1.5 rounded border border-red-100 hover:bg-red-100 transition">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-slate-500">No hay clientes ni agencias registradas en el sistema.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>